<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Costings and photos stay in the app's own container. Nothing is
	     sent anywhere, so nothing is collected. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- None of Apple's required-reason APIs are called: no UserDefaults,
	     no file timestamps, no disk space, no boot time, no keyboard list. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
